# LLM provider API keys (comma-separated, at least 2 keys)
# Key ids are key_1, key_2, ... in this exact order
LLM_API_KEYS=your_first_api_key_here,your_second_api_key_here

# LiteLLM model identifier (e.g. gemini/gemini-3-flash-preview, gpt-4o-mini, etc.)
LLM_MODEL=gemini/gemini-3-flash-preview

# SQLite DB location (in Docker: sqlite:////data/app.db; local: sqlite:///./data/app.db)
DATABASE_URL=sqlite:////data/app.db

# Frontend CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Enable failover test hook (X-Simulate-Failure)
ENABLE_FAILURE_SIMULATION=true
